/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# HTML pages must never be cached — always serve the latest deploy.
/*.html
  Cache-Control: no-cache, must-revalidate

# SW must never be served from cache — browser needs latest version on every load.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Manifest can be short-lived cached.
/manifest.json
  Cache-Control: no-cache

/api/*
  Access-Control-Allow-Origin: https://moshly.io
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
