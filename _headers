/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML pages must never be cached — always serve the latest deploy.
/*.html
  Cache-Control: no-cache, must-revalidate

# SW must never be served from cache — browser needs latest version on every load.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Manifest can be short-lived cached.
/manifest.json
  Cache-Control: no-cache

/api/*
  Access-Control-Allow-Origin: https://moshly.io
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
