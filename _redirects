# Root-level .html files (login, pricing, signup, dashboard, admin, etc.) are
# served at clean URLs automatically by Cloudflare Pages "Pretty URLs" feature.
# Do NOT add 200 rewrites for those here — _redirects 200 + Pretty URLs conflict,
# causing a self-referencing 308 redirect loop (/login -> /login -> ...).

# Non-standard paths: files in subdirectories that Pretty URLs won't surface.
/index              /                        301
/fifthsense         /apps/fifthsense.html    200
/quote              /apps/quote.html         200
